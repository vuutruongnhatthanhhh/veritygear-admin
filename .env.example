# Same Supabase project as the veritygear client app (shared auth.users + profiles table).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP used for staff "forgot password" emails (lib/mailer.ts). Any SMTP provider works
# (e.g. Gmail app password, Resend SMTP, Mailgun, etc.) — the same provider/account can
# be reused across veritygear and veritygear-admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
